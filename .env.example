# Porta em que o servidor Node escuta (HTTP + WebSocket na mesma porta).
PORT=3000

# Ambiente de execução.
NODE_ENV=production

# Onde o SQLite (tank.db — persistência de rating/ranking) é gravado dentro do container.
# No Coolify, monte um volume apontando pra este caminho (ver docker-compose.yml).
DATA_DIR=/app/data

# URL do webhook do n8n que recebe o ranking final de cada partida (POST JSON). Deixe em
# branco para desativar — o envio falha silenciosamente (só loga) se a URL não responder.
WEBHOOK_URL=
